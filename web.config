<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS : site attendance.admission.tn (C:\apps\attendance.admission.tn).
  1. HTTP → HTTPS (la géolocalisation n'existe qu'en HTTPS).
  2. Tout le reste → l'app Next.js lancée par pm2 sur le port 3070.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="HTTP vers HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="http://localhost:3070/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="NextJS Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3070/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors errorMode="DetailedLocalOnly" />
  </system.webServer>
</configuration>
